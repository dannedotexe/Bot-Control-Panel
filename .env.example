# Wird von install.sh erzeugt. Niemals committen, niemals in Chats/Screenshots zeigen.
BCP_PORT=8443
BCP_HOST=0.0.0.0
BCP_ADMIN_USER=admin
# scrypt-Hash, erzeugt mit: bash scripts/set-password.sh
BCP_ADMIN_PASSWORD_HASH=
# Zufallswert (mind. 32 Zeichen) zum Signieren der Session-Cookies
BCP_SESSION_SECRET=
# Optional: Base32-Secret für TOTP-2FA (bash scripts/setup-2fa.sh)
BCP_TOTP_SECRET=
# Pfad zum global installierten pm2-Modul (install.sh erkennt ihn automatisch)
BCP_PM2_MODULE=
# Optional
# BCP_TLS_CERT=data/tls/cert.pem
# BCP_TLS_KEY=data/tls/key.pem
# BCP_SESSION_IDLE_MINUTES=120
# BCP_SESSION_MAX_HOURS=12
# BCP_POLL_MS=3000
# Nur hinter lokalem Reverse-Proxy (Caddy/nginx terminiert TLS); dann BCP_HOST=127.0.0.1 setzen:
# BCP_BEHIND_PROXY=1
